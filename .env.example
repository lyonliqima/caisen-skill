# 七专家分析师 Agent - 环境变量配置模板
# 使用方法: 复制为 .env 即可（Key 已内置）
#   cp .env.example .env
# install.sh 也会自动完成此步骤

# 东方财富妙想 Skills API Key
# 用途: mx-data / mx-search / mx-xuangu / mx-zixuan / mx-moni / mx-poster 等数据工具必需
MX_APIKEY=mkt_YOUR_API_KEY_HERE

# （可选）妙想 API 服务地址，留空使用默认值
# MX_API_URL=https://mkapi2.dfcfs.com/finskillshub
